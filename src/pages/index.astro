---
// src/pages/index.astro
// Diaporama Plein Écran (3 Slides Fluides) avec Layout Adaptatif et Safe Zones Anti-Collision
import Layout from '../layouts/Layout.astro';
import SlideshowHUD from '../components/SlideshowHUD.astro';
import DitherVisual from '../components/DitherVisual.astro';
import { PROFILE } from '../data/profile';
import { getFeaturedProjects } from '../data/projects';

const featuredProjects = getFeaturedProjects();
---

<Layout isFullBleed={true} title="Adrian van Rijswijk // Portfolio BUT Informatique">
  <div class="relative w-screen h-screen overflow-hidden bg-[#0a0a0a] text-[#ededed]">
    <!-- Navigation HUD fixe en bordure avec barres de protection et safe zones -->
    <SlideshowHUD />

    <!-- Conteneur des 3 diapositives plein écran avec défilement fluide et snap -->
    <main
      id="slides-container"
      class="h-screen w-screen overflow-y-scroll snap-y-mandatory no-scrollbar scroll-smooth focus:outline-none"
      tabindex="0"
      aria-label="Présentation portfolio par diapositives"
    >
      <!-- ========================================================
           DIAPO 01 : HERO / INTRODUCTION
           ======================================================== -->
      <section
        id="slide-1"
        data-slide-index="1"
        data-slide-title="01 / 03 — INTRODUCTION"
        class="snap-slide min-h-screen w-screen flex flex-col justify-center px-6 sm:px-12 md:px-16 lg:px-24 pt-20 pb-20 sm:pt-24 sm:pb-24 lg:pt-28 lg:pb-28 relative select-none"
      >
        <div class="w-full max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <!-- Colonne Gauche : Typographie éditoriale & Actions -->
          <div class="lg:col-span-7 flex flex-col items-start z-10">
            <!-- Sous-titre Monospace avec effet Text Scramble -->
            <div
              class="font-mono text-xs sm:text-sm uppercase tracking-widest text-[#888888] mb-4 flex items-center gap-2"
            >
              <span class="w-1.5 h-1.5 bg-accent"></span>
              <span class="scramble-text" data-scramble="// BUT 3 Informatique · UNIVERSITÉ DE LIMOGES">
                // BUT 3 Informatique · UNIVERSITÉ DE LIMOGES
              </span>
            </div>

            <!-- Nom en très grande taille Serif éditorial -->
            <h1 class="slide-title font-serif text-5xl sm:text-6xl md:text-7xl lg:text-8xl tracking-tight text-[#ededed] leading-[0.95] mb-6">
              Adrian van<br class="hidden sm:inline" /> Rijswijk
            </h1>

            <!-- Bio / Accroche technique -->
            <p class="font-mono text-xs sm:text-sm md:text-base text-[#888888] max-w-xl leading-relaxed mb-8">
              Développeur junior en développement Web / Logiciel et culture DevOps. Actuellement en BUT Informatique, je recherche un stage de 16 semaines pour approfondir mes acquis et améliorer mes compétences professionnelles.
            </p>

            <!-- Boutons d'action francs, 0 radius, inversion hover -->
            <div class="flex flex-wrap items-center gap-4 font-mono text-xs tracking-wider uppercase">
              <a
                href="#slide-2"
                class="px-6 py-4 bg-white text-black hover:bg-accent hover:text-black transition-colors duration-100 font-bold flex items-center gap-2.5 cursor-pointer"
              >
                <span>Explorer les projets phares</span>
                <span>↓</span>
              </a>

              <a
                href={PROFILE.contacts.cvUrl || '#'}
                target="_blank"
                rel="noopener noreferrer"
                class="px-6 py-4 border border-[#262626] text-[#ededed] hover:bg-[#ededed] hover:text-[#0a0a0a] transition-colors duration-100 flex items-center gap-2.5 cursor-pointer"
              >
                <span>Télécharger CV</span>
                <span>↗</span>
              </a>
            </div>
          </div>

          <!-- Colonne Droite : Visuel 1-bit interactif libre (sans boîte fermée) -->
          <div class="lg:col-span-5 flex items-center justify-center relative">
            <DitherVisual />
          </div>
        </div>
      </section>

      <!-- ========================================================
           DIAPO 02 : LES 3 PROJETS PHARES RÉUNIS + GROS BOUTON
           ======================================================== -->
      <section
        id="slide-2"
        data-slide-index="2"
        data-slide-title="02 / 03 — PROJETS PHARES"
        class="snap-slide min-h-screen w-screen flex flex-col justify-center px-4 sm:px-8 md:px-12 lg:px-16 pt-20 pb-20 sm:pt-24 sm:pb-24 lg:pt-28 lg:pb-28 relative select-none"
      >
        <!-- Grand filigrane d'index en arrière-plan -->
        <span
          class="absolute right-4 sm:right-12 top-1/2 -translate-y-1/2 font-mono text-[140px] sm:text-[220px] lg:text-[280px] font-bold opacity-[0.03] select-none pointer-events-none text-white"
          aria-hidden="true"
        >
          002
        </span>

        <div class="w-full max-w-7xl mx-auto flex flex-col justify-center z-10 space-y-5 sm:space-y-6">
          <!-- En-tête de la diapo -->
          <div>
            <div class="flex items-center gap-3 font-mono text-xs mb-2">
              <span class="text-accent font-bold scramble-text" data-scramble="[002 / VITRINE]">
                [002 / VITRINE]
              </span>
              <span class="text-[#555555]">//</span>
              <span class="text-[#888888] uppercase tracking-wider font-semibold">
                SÉLECTION DE 3 RÉALISATIONS PHARES
              </span>
            </div>
            <h2 class="slide-title font-serif text-3xl sm:text-4xl lg:text-5xl tracking-tight text-[#ededed] leading-tight">
              Projets Phares & Réalisations Majeures
            </h2>
          </div>

          <!-- Grille des 3 projets phares (3 colonnes équilibrées) -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-6 items-stretch">
            {featuredProjects.map((project) => (
              <article class="border border-[#262626] bg-[#0c0c0c] hover:bg-[#111111] hover:border-accent/80 transition-colors p-4 lg:p-5 flex flex-col justify-between group">
                <!-- En-tête de carte -->
                <div>
                  <div class="flex items-center justify-between font-mono text-[11px] mb-3 pb-2 border-b border-[#222222]">
                    <span class="text-accent font-bold">[{project.index}] // {project.year}</span>
                    <span class="border border-accent/60 text-accent px-1.5 py-0.5 text-[9px] uppercase font-semibold">
                      ■ {project.competenceId.toUpperCase()}
                    </span>
                  </div>

                  <!-- Zone d'aperçu visuel adapté sans déformation -->
                  <a
                    href={`${import.meta.env.BASE_URL}projets/${project.slug}`}
                    class="h-32 sm:h-36 lg:h-40 w-full bg-[#060606] border border-[#1f1f1f] relative flex items-center justify-center p-2 overflow-hidden block mb-3"
                    aria-label={`Voir l'étude de cas de ${project.title}`}
                  >
                    {project.slug === 'tonote-android' ? (
                      /* Mobile vertical : châssis smartphone propre sans étirement */
                      <div class="h-full flex items-center justify-center">
                        <div class="h-[95%] aspect-[9/18] border border-[#333333] bg-black p-0.5 shadow-none flex items-center justify-center overflow-hidden">
                          <img
                            src={project.image || `${import.meta.env.BASE_URL}images/projects/tonote-1.png`}
                            alt={`Capture mobile de ${project.title}`}
                            class="w-full h-full object-contain grayscale group-hover:grayscale-0 opacity-85 group-hover:opacity-100 transition-all duration-200"
                            loading="lazy"
                          />
                        </div>
                      </div>
                    ) : project.image ? (
                      /* Capture web : ratio d'origine préservé */
                      <div class="w-full h-full flex items-center justify-center p-1">
                        <img
                          src={project.image}
                          alt={`Aperçu web de ${project.title}`}
                          class="max-w-full max-h-full object-contain grayscale group-hover:grayscale-0 opacity-80 group-hover:opacity-100 transition-all duration-200"
                          loading="lazy"
                        />
                      </div>
                    ) : (
                      /* CTF Infra : Télémétrie terminal miniature */
                      <div class="w-full h-full p-2.5 flex flex-col justify-between font-mono text-[9px] text-[#888888] bg-[#090909]">
                        <div class="flex items-center justify-between border-b border-[#222222] pb-1">
                          <span class="text-[#ededed] font-bold">CTF_VLAN_GATEWAY</span>
                          <span class="text-emerald-400">● ISOLATED</span>
                        </div>
                        <div class="text-[8px] space-y-0.5 my-auto">
                          <div>[GW: 10.100.0.1 / VLAN 404]</div>
                          <div class="text-accent">20 CHALLENGES DOCKER ACTIVE</div>
                        </div>
                        <div class="border-t border-[#222222] pt-1 flex justify-between text-[8px] text-[#555555]">
                          <span>DSI UNIV LIMOGES</span>
                          <span class="text-white">DEV_OPS</span>
                        </div>
                      </div>
                    )}
                  </a>

                  <!-- Titre du projet en grand Serif -->
                  <h3 class="font-serif text-lg sm:text-xl text-[#ededed] group-hover:text-accent transition-colors leading-snug mb-1.5">
                    <a href={`${import.meta.env.BASE_URL}projets/${project.slug}`}>
                      {project.title}
                    </a>
                  </h3>

                  <!-- Court descriptif -->
                  <p class="font-mono text-[11px] text-[#888888] line-clamp-2 leading-relaxed mb-3">
                    {project.shortDescription}
                  </p>
                </div>

                <!-- Tags & Lien vers fiche -->
                <div>
                  <div class="flex flex-wrap gap-1 font-mono text-[9px] text-[#777777] mb-3">
                    {project.tags.slice(0, 3).map((tag) => (
                      <span class="px-1.5 py-0.5 border border-[#222222] bg-[#141414]">
                        {tag}
                      </span>
                    ))}
                    {project.tags.length > 3 && (
                      <span class="px-1.5 py-0.5 text-[#555555]">+{project.tags.length - 3}</span>
                    )}
                  </div>

                  <a
                    href={`${import.meta.env.BASE_URL}projets/${project.slug}`}
                    class="pt-2 border-t border-[#1f1f1f] text-xs font-mono text-[#ededed] hover:text-accent transition-colors flex items-center justify-between font-semibold"
                  >
                    <span>Voir l'étude de cas</span>
                    <span>→</span>
                  </a>
                </div>
              </article>
            ))}
          </div>

          <!-- Gros bouton d'accès à l'ensemble des projets -->
          <div class="w-full border border-[#262626] bg-[#111111] p-4 sm:p-5 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <span class="w-2.5 h-2.5 bg-accent inline-block shrink-0"></span>
              <div>
                <span class="font-mono text-[10px] text-accent uppercase font-bold tracking-wider block">
                  RÉFÉRENTIEL COMPLET DU BUT INFORMATIQUE
                </span>
                <span class="font-serif text-base sm:text-lg text-[#ededed]">
                  Explorer l'ensemble des projets classés par compétences (C1 à C6)
                </span>
              </div>
            </div>

            <a
              href={`${import.meta.env.BASE_URL}projets`}
              class="w-full sm:w-auto px-6 py-3.5 bg-white text-black hover:bg-accent hover:text-black transition-colors duration-100 font-mono text-xs font-bold uppercase tracking-wider flex items-center justify-center gap-2.5 shrink-0 cursor-pointer"
            >
              <span>VOIR TOUS LES PROJETS</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </section>

      <!-- ========================================================
           DIAPO 03 : INFORMATIONS PERSONNELLES & CONTACTS
           ======================================================== -->
      <section
        id="slide-3"
        data-slide-index="3"
        data-slide-title="03 / 03 — PROFIL & CONTACTS"
        class="snap-slide min-h-screen w-screen flex flex-col justify-center px-4 sm:px-8 md:px-12 lg:px-16 pt-20 pb-20 sm:pt-24 sm:pb-24 lg:pt-28 lg:pb-28 relative select-none"
      >
        <!-- Grand filigrane d'index en arrière-plan -->
        <span
          class="absolute right-4 sm:right-12 top-1/2 -translate-y-1/2 font-mono text-[140px] sm:text-[220px] lg:text-[280px] font-bold opacity-[0.03] select-none pointer-events-none text-white"
          aria-hidden="true"
        >
          003
        </span>

        <div class="w-full max-w-7xl mx-auto flex flex-col justify-center z-10 space-y-5 sm:space-y-6">
          <!-- En-tête de la diapo -->
          <div>
            <div class="flex items-center gap-3 font-mono text-xs mb-2">
              <span class="text-accent font-bold scramble-text" data-scramble="[003 / CONCLUSION]">
                [003 / CONCLUSION]
              </span>
              <span class="text-[#555555]">//</span>
              <span class="text-[#888888] uppercase tracking-wider font-semibold">
                PARCOURS ACADÉMIQUE, PROFIL & CONTACT
              </span>
            </div>
            <h2 class="slide-title font-serif text-3xl sm:text-4xl lg:text-5xl tracking-tight text-[#ededed] leading-tight">
              Informations Personnelles & Prise de Contact
            </h2>
          </div>

          <!-- Grille centrale 2 colonnes équilibrées -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-8 items-start">
            <!-- Colonne Gauche : Parcours & Philosophie -->
            <div class="lg:col-span-6 space-y-4 font-mono text-xs">
              <div class="border border-[#262626] bg-[#0c0c0c] p-4 sm:p-5">
                <span class="text-[10px] uppercase text-accent font-bold tracking-wider block mb-1">
                  // CANDIDAT & FORMATION
                </span>
                <div class="font-serif text-2xl text-[#ededed] mb-4">
                  {PROFILE.fullName}
                </div>
                <div class="text-[#888888] mb-3 text-[11px]">
                  {PROFILE.academicPath[0]}
                </div>
                <div class="text-[11px] text-[#888888] leading-relaxed space-y-2">
                  <p class="mb-6">{PROFILE.academicPath[1]}</p>
                  <p class="text-[#999999]"><strong class="text-[#ededed]">Centre d'intérêts :</strong> {PROFILE.hobbies}</p>
                </div>
              </div>
            </div>

            <!-- Colonne Droite : Recherche Professionnelle & Boîte de Contact -->
            <div class="lg:col-span-6 space-y-4 font-mono text-xs">
              <!-- Encart recherche de stage -->
              <div class="border border-[#262626] bg-[#0e0e0e] p-4 flex items-start gap-3">
                <span class="text-emerald-400 font-bold text-sm">[!]</span>
                <div>
                  <span class="text-[10px] uppercase text-emerald-400 font-bold tracking-wider block">
                    STAGE RECHERCHÉ (FIN D'ÉTUDES)
                  </span>
                  <p class="text-[11px] text-[#888888] leading-relaxed mt-0.5">
                    {PROFILE.lookingFor}
                  </p>
                </div>
              </div>
              <!-- Coordonnées & Prise de Contact -->
              <div class="border border-[#262626] bg-[#0c0c0c] p-4 sm:p-5">
                <span class="text-[10px] uppercase text-[#888888] font-bold tracking-wider block mb-3">
                  // COORDONNÉES DIRECTES & RÉSEAUX
                </span>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs mb-4">
                  <div>
                    <span class="text-[10px] text-[#555555] block">EMAIL PERSONNEL :</span>
                    <a
                      href={`mailto:${PROFILE.contacts.email}`}
                      class="text-[#ededed] hover:text-accent font-semibold transition-colors truncate block"
                    >
                      {PROFILE.contacts.email} ↗
                    </a>
                  </div>
                  <div>
                    <span class="text-[10px] text-[#555555] block">EMAIL ÉTUDIANT :</span>
                    <a
                      href={`mailto:${PROFILE.contacts.studentEmail}`}
                      class="text-[#ededed] hover:text-accent font-semibold transition-colors truncate block"
                    >
                      {PROFILE.contacts.studentEmail} ↗
                    </a>
                  </div>
                </div>

                <div class="flex flex-wrap items-center gap-2 pt-3 border-t border-[#1f1f1f]">
                  <a
                    href={PROFILE.contacts.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-3 py-1.5 border border-[#262626] text-[#ededed] hover:border-accent hover:text-accent transition-colors flex items-center gap-1.5 text-[11px]"
                  >
                    <span>GitHub ↗</span>
                  </a>
                  <a
                    href={PROFILE.contacts.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-3 py-1.5 border border-[#262626] text-[#ededed] hover:border-accent hover:text-accent transition-colors flex items-center gap-1.5 text-[11px]"
                  >
                    <span>LinkedIn ↗</span>
                  </a>
                  <a
                    href={PROFILE.contacts.cvUrl || '#'}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-3.5 py-1.5 bg-white text-black hover:bg-accent hover:text-black transition-colors font-bold ml-auto text-[11px]"
                  >
                    <span>TÉLÉCHARGER CV (PDF) ↗</span>
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Pied de page technique -->
          <footer class="pt-3 border-t border-[#262626] flex items-center justify-between font-mono text-[10px] text-[#555555]">
            <span>© 2026 {PROFILE.fullName} // UNIVERSITÉ DE LIMOGES // IUT DU LIMOUSIN</span>
            <a href="#slide-1" class="text-[#ededed] hover:text-accent transition-colors font-semibold">
              RETOUR HAUT [01] ↑
            </a>
          </footer>
        </div>
      </section>
    </main>
  </div>
</Layout>

<script>
  // ========================================================
  // SLIDESHOW CONTROLLER & OBSERVER (3 SLIDES ADAPTATIVES)
  // ========================================================
  function initSlideshow() {
    const container = document.getElementById('slides-container');
    const slides = Array.from(document.querySelectorAll<HTMLElement>('.snap-slide'));
    const hudCounter = document.getElementById('hud-slide-counter');
    const progressSegments = Array.from(document.querySelectorAll<HTMLButtonElement>('.hud-progress-seg'));
    const scrollDownBtn = document.getElementById('hud-scroll-down');
    const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.hud-nav-link'));

    if (!container || slides.length === 0) return;

    let currentSlideIndex = 1;
    const totalSlides = slides.length;

    // ------------------------------------------------------
    // Text Scramble Effect Function
    // ------------------------------------------------------
    const SCRAMBLE_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_#@%&+-/*';
    function triggerScramble(element: HTMLElement) {
      const original = element.getAttribute('data-scramble') || element.textContent?.trim() || '';
      element.setAttribute('data-scramble', original);
      let iteration = 0;
      const maxIterations = 10;
      const interval = setInterval(() => {
        element.textContent = original
          .split('')
          .map((char, index) => {
            if (char === ' ') return ' ';
            if (index < (iteration / maxIterations) * original.length) {
              return original[index];
            }
            return SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
          })
          .join('');

        iteration++;
        if (iteration > maxIterations) {
          clearInterval(interval);
          element.textContent = original;
        }
      }, 25);
    }

    // ------------------------------------------------------
    // Update Slide State (Counter, Progress Bars, Active Slide)
    // ------------------------------------------------------
    function onSlideActive(index: number) {
      currentSlideIndex = index;
      const activeSlide = slides[index - 1];
      if (!activeSlide) return;

      // Update HUD counter
      const title = activeSlide.getAttribute('data-slide-title') || `0${index} / 0${totalSlides}`;
      if (hudCounter) {
        hudCounter.textContent = title;
      }

      // Update segmented progress bars
      progressSegments.forEach((seg, i) => {
        const segIndex = i + 1;
        if (segIndex === index) {
          seg.classList.remove('bg-white/20');
          seg.classList.add('bg-white');
        } else {
          seg.classList.remove('bg-white');
          seg.classList.add('bg-white/20');
        }
      });

      // Update Nav links
      navLinks.forEach((link) => {
        const target = Number(link.getAttribute('data-target-slide'));
        if (target === index) {
          link.classList.add('text-white', 'font-bold');
          link.classList.remove('text-[#888888]');
        } else {
          link.classList.remove('text-white', 'font-bold');
          link.classList.add('text-[#888888]');
        }
      });

      // Trigger text scramble on Monospace subtitles
      const scrambles = activeSlide.querySelectorAll<HTMLElement>('.scramble-text');
      scrambles.forEach((el) => triggerScramble(el));

      // Trigger crisp reveal on Serif slide titles
      const slideTitle = activeSlide.querySelector<HTMLElement>('.slide-title');
      if (slideTitle) {
        slideTitle.style.opacity = '1';
        slideTitle.style.transform = 'translateY(0)';
      }
    }

    // ------------------------------------------------------
    // Intersection Observer for Snap Scroll Detection (Seuil souple 0.35)
    // ------------------------------------------------------
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const index = Number(entry.target.getAttribute('data-slide-index'));
            if (!isNaN(index)) {
              onSlideActive(index);
            }
          }
        });
      },
      {
        root: container,
        threshold: 0.35,
      }
    );

    slides.forEach((slide) => observer.observe(slide));

    // ------------------------------------------------------
    // Navigation helper (alignement start propre)
    // ------------------------------------------------------
    function scrollToSlide(index: number) {
      if (index < 1) index = 1;
      if (index > totalSlides) index = totalSlides;
      const targetSlide = document.getElementById(`slide-${index}`);
      if (targetSlide) {
        targetSlide.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // Scroll down button
    if (scrollDownBtn) {
      scrollDownBtn.addEventListener('click', () => {
        if (currentSlideIndex >= totalSlides) {
          scrollToSlide(1);
        } else {
          scrollToSlide(currentSlideIndex + 1);
        }
      });
    }

    // Progress bar segment clicks
    progressSegments.forEach((seg) => {
      seg.addEventListener('click', () => {
        const jump = Number(seg.getAttribute('data-jump-slide'));
        if (!isNaN(jump)) {
          scrollToSlide(jump);
        }
      });
    });

    // Nav link clicks
    navLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        const target = Number(link.getAttribute('data-target-slide'));
        if (!isNaN(target)) {
          e.preventDefault();
          scrollToSlide(target);
        }
      });
    });

    // ------------------------------------------------------
    // Keyboard Navigation (Arrow Keys, PageUp, PageDown, Space)
    // ------------------------------------------------------
    window.addEventListener('keydown', (e) => {
      if (['INPUT', 'TEXTAREA', 'SELECT'].includes((e.target as HTMLElement)?.tagName)) {
        return;
      }

      if (e.key === 'ArrowDown' || e.key === 'PageDown' || (e.key === ' ' && !e.shiftKey)) {
        if (currentSlideIndex < totalSlides) {
          e.preventDefault();
          scrollToSlide(currentSlideIndex + 1);
        }
      } else if (e.key === 'ArrowUp' || e.key === 'PageUp' || (e.key === ' ' && e.shiftKey)) {
        if (currentSlideIndex > 1) {
          e.preventDefault();
          scrollToSlide(currentSlideIndex - 1);
        }
      } else if (e.key === 'Home') {
        e.preventDefault();
        scrollToSlide(1);
      } else if (e.key === 'End') {
        e.preventDefault();
        scrollToSlide(totalSlides);
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initSlideshow);
  initSlideshow();
</script>
