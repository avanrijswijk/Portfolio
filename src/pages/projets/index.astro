---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ContactFooter from '../../components/ContactFooter.astro';
import { COMPETENCES, getProjectsByCompetence } from '../../data/projects';
---

<Layout
  title="Projets par Compétences du BUT - Adrian van Rijswijk"
  description="Référentiel des réalisations et projets informatiques d'Adrian van Rijswijk, structurés selon les 6 compétences du BUT Informatique."
>
  <div class="flex flex-col">
    <!-- Barre d'état sticky -->
    <Header currentPath="/projets" />

    <main class="border-b border-neutral-800">
      <!-- En-tête de la page Projets (Spacieux, Datasheet) -->
      <section class="p-8 sm:p-12 lg:p-16 border-b border-neutral-800 bg-neutral-950">
        <div class="flex items-center gap-3 font-mono text-xs text-neutral-500 uppercase tracking-widest mb-6">
          <a href="/" class="hover:text-white transition-colors">ACCUEIL</a>
          <span>//</span>
          <span class="text-neutral-300 font-semibold">RÉFÉRENTIEL BUT INFORMATIQUE</span>
          <span>//</span>
          <span class="text-emerald-400">6 COMPÉTENCES</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-mono text-neutral-100 uppercase tracking-tight leading-tight mb-6">
          Projets & Réalisations par Compétences
        </h1>

        <p class="text-neutral-400 text-base sm:text-lg max-w-3xl font-sans leading-relaxed mb-8">
          Explorez l’ensemble de mes réalisations académiques (SAE) et expériences professionnelles. Cliquez sur une compétence pour déplier ou replier ses projets associés.
        </p>

        <!-- Barre d'actions & Navigation rapide entre compétences -->
        <div class="pt-6 border-t border-neutral-800 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 font-mono text-xs">
          <!-- Ancres directes -->
          <nav class="flex flex-wrap items-center gap-2" aria-label="Accès rapide par compétence">
            <span class="text-neutral-500 uppercase py-1 mr-1">Aller à :</span>
            {COMPETENCES.map((comp) => (
              <button
                type="button"
                data-jump-competence={comp.id}
                class="jump-btn px-3 py-1.5 border border-neutral-800 hover:border-neutral-500 hover:bg-neutral-900 text-neutral-300 hover:text-white transition-colors uppercase cursor-pointer"
              >
                [{comp.shortCode}] {comp.name}
              </button>
            ))}
          </nav>

          <!-- Contrôles Tout déplier / Tout replier -->
          <div class="flex items-center gap-2 shrink-0">
            <button
              id="expand-all-btn"
              type="button"
              class="px-3.5 py-1.5 border border-neutral-800 bg-neutral-900 hover:border-neutral-500 text-neutral-300 hover:text-white transition-colors uppercase font-medium cursor-pointer"
            >
              [+] Tout déplier
            </button>
            <button
              id="collapse-all-btn"
              type="button"
              class="px-3.5 py-1.5 border border-neutral-800 bg-neutral-900 hover:border-neutral-500 text-neutral-300 hover:text-white transition-colors uppercase font-medium cursor-pointer"
            >
              [-] Tout replier
            </button>
          </div>
        </div>
      </section>

      <!-- Liste en accordéon déroulant des 6 Compétences -->
      <div id="competences-accordion-list" class="divide-y divide-neutral-800">
        {COMPETENCES.map((competence, idx) => {
          const compProjects = getProjectsByCompetence(competence.id);
          const isOpenDefault = idx === 0; // Ouvre la première compétence par défaut pour guider l'utilisateur

          return (
            <details
              id={competence.id}
              class="competence-accordion group bg-[#0a0a0a] transition-colors"
              open={isOpenDefault}
            >
              <!-- En-tête cliquable (Summary) de la compétence -->
              <summary class="p-6 sm:p-8 hover:bg-neutral-950 cursor-pointer list-none [&::-webkit-details-marker]:hidden flex flex-col md:flex-row items-start md:items-center justify-between gap-4 select-none group-open:bg-neutral-950/90 transition-colors">
                <div class="flex items-center gap-3.5 flex-wrap">
                  <span class="px-2.5 py-1 bg-neutral-900 border border-neutral-800 text-emerald-400 font-mono font-bold text-xs">
                    {competence.shortCode}
                  </span>
                  <h2 class="text-lg sm:text-xl font-bold font-mono text-neutral-100 uppercase group-hover:text-white transition-colors">
                    {competence.title}
                  </h2>
                  <span class="px-2.5 py-0.5 border border-neutral-800 text-[11px] font-mono text-neutral-400 bg-neutral-900/60">
                    {compProjects.length > 0
                      ? `${compProjects.length} PROJET${compProjects.length > 1 ? 'S' : ''}`
                      : 'TRANSVERSALE'}
                  </span>
                </div>

                <div class="flex items-center gap-4 shrink-0 self-end md:self-auto font-mono text-xs">
                  <span class="text-neutral-500 text-[11px] hidden xl:inline max-w-sm truncate">
                    {competence.description}
                  </span>
                  <span class="px-3.5 py-1.5 border border-neutral-800 bg-neutral-900 text-neutral-300 group-hover:border-neutral-500 transition-colors inline-flex items-center gap-1.5">
                    <span class="group-open:hidden text-neutral-400 font-semibold">[+] DÉPLIER</span>
                    <span class="hidden group-open:inline text-emerald-400 font-semibold">[-] REPLIER</span>
                  </span>
                </div>
              </summary>

              <!-- Contenu déroulé : Projets de la compétence -->
              <div class="border-t border-neutral-800 bg-[#0a0a0a]">
                <!-- Bandeau descriptif de la compétence -->
                <div class="px-6 sm:px-8 py-4 bg-neutral-950 border-b border-neutral-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 font-mono text-xs text-neutral-400">
                  <p class="leading-relaxed">
                    <strong class="text-neutral-300 uppercase mr-1">Axe BUT :</strong>
                    {competence.description}
                  </p>
                  <span class="text-[10px] text-neutral-500 shrink-0 uppercase tracking-wider">
                    {compProjects.length} ENTRÉES DISPONIBLES
                  </span>
                </div>

                <!-- Grille des projets -->
                {compProjects.length > 0 ? (
                  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 bg-neutral-800 gap-[1px]">
                    {compProjects.map((project) => (
                      <article class="flex flex-col justify-between bg-[#0a0a0a] hover:bg-[#0e0e0e] transition-colors p-0 group">
                        <!-- En-tête de carte -->
                        <div class="px-6 py-4 border-b border-neutral-800 flex items-center justify-between font-mono text-xs text-neutral-400 bg-neutral-950/60">
                          <div class="flex items-center gap-2">
                            <span class="text-neutral-100 font-bold">{project.index}</span>
                            <span class="text-neutral-600">//</span>
                            <span class="text-neutral-400">{project.year}</span>
                          </div>
                          <span class="px-2 py-0.5 border border-neutral-800 text-[10px] text-neutral-400 uppercase">
                            {project.category}
                          </span>
                        </div>

                        <!-- Zone d'aperçu adaptée au format -->
                        <a
                          href={`/projets/${project.slug}`}
                          class="aspect-video w-full bg-neutral-950 border-b border-neutral-800 relative flex items-center justify-center overflow-hidden block p-2"
                        >
                          {project.image ? (
                            <img
                              src={project.image}
                              alt={`Aperçu du projet ${project.title}`}
                              class="max-h-full max-w-full object-contain grayscale group-hover:grayscale-0 opacity-85 group-hover:opacity-100 transition-all duration-300"
                              loading="lazy"
                            />
                          ) : (
                            <div class="w-full h-full flex flex-col items-center justify-center p-4 border border-dashed border-neutral-800/80 bg-neutral-900/30">
                              <span class="font-mono text-xs uppercase tracking-wider text-neutral-500">
                                [APERÇU PROJET]
                              </span>
                              <span class="font-mono text-[10px] text-neutral-600 mt-1">
                                FICHE DÉTAILLÉE
                              </span>
                            </div>
                          )}
                          <div class="absolute bottom-2.5 right-2.5 px-2 py-1 bg-neutral-950/90 font-mono text-[10px] text-neutral-300 border border-neutral-800 opacity-0 group-hover:opacity-100 transition-opacity">
                            FICHE TECHNIQUE →
                          </div>
                        </a>

                        <!-- Corps de la carte -->
                        <div class="p-6 sm:p-7 grow flex flex-col">
                          <h3 class="font-mono font-bold text-base sm:text-lg text-neutral-100 mb-2.5 group-hover:text-emerald-400 transition-colors leading-snug">
                            <a href={`/projets/${project.slug}`}>
                              {project.title}
                            </a>
                          </h3>

                          <p class="text-xs sm:text-sm text-neutral-300 font-sans leading-relaxed mb-4">
                            {project.shortDescription}
                          </p>

                          <div class="mt-auto pt-3 border-t border-neutral-800/80">
                            <p class="text-xs font-mono text-neutral-400 leading-relaxed">
                              <strong class="text-neutral-200 font-semibold uppercase text-[10px] block mb-1 tracking-wider">
                                Problématique technique :
                              </strong>
                              {project.technicalProblem}
                            </p>
                          </div>
                        </div>

                        <!-- Pied de carte -->
                        <div class="p-6 border-t border-neutral-800 bg-neutral-950/40 flex flex-col gap-3.5">
                          <div class="flex flex-wrap gap-1.5" aria-label="Technologies utilisées">
                            {project.tags.slice(0, 4).map((tag) => (
                              <span class="px-2.5 py-1 border border-neutral-800 font-mono text-[10px] text-neutral-400 uppercase tracking-tight bg-neutral-900/50">
                                {tag}
                              </span>
                            ))}
                            {project.tags.length > 4 && (
                              <span class="px-2 py-1 border border-neutral-800 font-mono text-[10px] text-neutral-500">
                                +{project.tags.length - 4}
                              </span>
                            )}
                          </div>

                          <div class="flex items-center justify-between pt-3 border-t border-neutral-800/80 font-mono text-xs">
                            <a
                              href={`/projets/${project.slug}`}
                              class="text-neutral-200 hover:text-emerald-400 font-semibold transition-colors inline-flex items-center gap-1.5"
                            >
                              <span>Consulter la fiche</span>
                              <span>→</span>
                            </a>

                            {project.githubUrl && (
                              <a
                                href={project.githubUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-neutral-400 hover:text-white transition-colors inline-flex items-center gap-1 group/gh"
                              >
                                <span>GitHub</span>
                                <span class="group-hover/gh:translate-x-0.5 group-hover/gh:-translate-y-0.5 transition-transform">↗</span>
                              </a>
                            )}
                          </div>
                        </div>
                      </article>
                    ))}
                  </div>
                ) : (
                  /* Cas de la compétence 6 : transversale */
                  <div class="p-8 sm:p-12 bg-[#0a0a0a]">
                    <div class="max-w-3xl border border-dashed border-neutral-700/80 bg-neutral-950/60 p-8 font-mono">
                      <span class="text-emerald-400 text-xs uppercase tracking-wider font-semibold block mb-2">
                        [COMPÉTENCE TRANSVERSALE APPLIQUÉE]
                      </span>
                      <h3 class="text-lg font-bold text-neutral-100 uppercase mb-3">
                        Pratiques Collaboratives & Travail d’Équipe
                      </h3>
                      <p class="text-sm text-neutral-300 font-sans leading-relaxed mb-6">
                        La compétence Collaborer est intégrée de façon transversale dans l’ensemble de mes projets de SAE et de stage. Elle se concrétise au quotidien par l’application stricte des flux Git (GitFlow, branches de fonctionnalités, Pull Requests), la pratique du Pair Programming, les revues de code systématiques et la tenue de réunions agiles (sprints, standups, rétrospectives).
                      </p>
                      <div class="flex flex-wrap gap-2 text-xs">
                        <span class="px-3 py-1 border border-neutral-800 bg-neutral-900 text-neutral-300">
                          Git & GitHub Teams
                        </span>
                        <span class="px-3 py-1 border border-neutral-800 bg-neutral-900 text-neutral-300">
                          Pair Programming
                        </span>
                        <span class="px-3 py-1 border border-neutral-800 bg-neutral-900 text-neutral-300">
                          Code Reviews & CI
                        </span>
                        <span class="px-3 py-1 border border-neutral-800 bg-neutral-900 text-neutral-300">
                          Méthodes Agiles / Scrum
                        </span>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </details>
          );
        })}
      </div>
    </main>

    <!-- Footer -->
    <ContactFooter />
  </div>
</Layout>

<!-- Script interactif pour dérouler / replier et navigation rapide -->
<script>
  function setupAccordionControls() {
    const accordions = document.querySelectorAll<HTMLDetailsElement>('.competence-accordion');
    const expandAllBtn = document.getElementById('expand-all-btn');
    const collapseAllBtn = document.getElementById('collapse-all-btn');
    const jumpButtons = document.querySelectorAll<HTMLButtonElement>('[data-jump-competence]');

    // Tout déplier
    expandAllBtn?.addEventListener('click', () => {
      accordions.forEach((acc) => (acc.open = true));
    });

    // Tout replier
    collapseAllBtn?.addEventListener('click', () => {
      accordions.forEach((acc) => (acc.open = false));
    });

    // Saut direct à une compétence : déplie automatiquement la section ciblée et scroll vers elle
    jumpButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-jump-competence');
        if (!targetId) return;

        const targetAccordion = document.getElementById(targetId) as HTMLDetailsElement | null;
        if (targetAccordion) {
          targetAccordion.open = true;
          targetAccordion.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupAccordionControls);
  setupAccordionControls();
</script>
