---
// src/pages/projets/[slug].astro
// Étude de Cas à Écran Scindé : 30% Gauche Fixe (Identité & Sommaire) / 70% Droite Défilante (Récit & Preuves)
import Layout from '../../layouts/Layout.astro';
import SecondaryHUD from '../../components/SecondaryHUD.astro';
import { PROJECTS, type Project } from '../../data/projects';

export function getStaticPaths() {
  return PROJECTS.map((project, index) => {
    const prevProject = index > 0 ? PROJECTS[index - 1] : null;
    const nextProject = index < PROJECTS.length - 1 ? PROJECTS[index + 1] : null;

    return {
      params: { slug: project.slug },
      props: { project, prevProject, nextProject },
    };
  });
}

interface Props {
  project: Project;
  prevProject: Project | null;
  nextProject: Project | null;
}

const { project, prevProject, nextProject } = Astro.props;
---

<Layout
  isFullBleed={true}
  title={`${project.title} // Adrian van Rijswijk`}
  description={project.shortDescription}
>
  <div class="min-h-screen bg-[#0a0a0a] text-[#ededed]">
    <!-- HUD fixe aux 4 coins adapté à l'étude de cas -->
    <SecondaryHUD
      currentPath="/projets"
      pageContext={`ÉTUDE DE CAS : [${project.index}] // ${project.competenceId.toUpperCase()}`}
    />

    <!-- Conteneur principal plein écran scindé en 2 colonnes (30% Gauche / 70% Droite) -->
    <main class="pt-24 sm:pt-28 pb-28 px-4 sm:px-8 lg:px-14">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <!-- ========================================================
             COLONNE GAUCHE FIXE (30% - lg:col-span-4 sticky top-28)
             Fiche d'identité, Navigation, Métadonnées et Sommaire
             ======================================================== -->
        <aside class="lg:col-span-4 lg:sticky lg:top-28 space-y-8 select-none">
          <!-- Bouton Retour à l'index -->
          <div>
            <a
              href="/projets"
              class="inline-flex items-center gap-2 font-mono text-xs text-[#888888] hover:text-accent transition-colors font-semibold uppercase tracking-wider"
            >
              <span>←</span>
              <span>RETOUR À L'INDEX DES PROJETS</span>
            </a>
          </div>

          <!-- Titre & Identité du projet -->
          <div class="pb-6 border-b border-[#222222]">
            <div class="flex items-center gap-2 font-mono text-[11px] text-accent font-bold mb-2">
              <span>[SPEC_ID: {project.index}]</span>
              <span class="text-[#444444]">//</span>
              <span>{project.year}</span>
            </div>

            <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl tracking-tight text-[#ededed] leading-[1.05] mb-3">
              {project.title}
            </h1>

            <div class="font-mono text-xs text-accent uppercase tracking-wider font-semibold">
              // {project.category} · {project.competenceId.toUpperCase()}
            </div>
          </div>

          <!-- Liens d'action épurés -->
          <div class="space-y-2 font-mono text-xs pb-6 border-b border-[#222222]">
            {project.githubUrl && (
              <a
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between py-2 text-[#ededed] hover:text-accent transition-colors group"
              >
                <span>Code Source GitHub</span>
                <span class="text-[#666666] group-hover:text-accent transition-colors">↗</span>
              </a>
            )}

            {project.demoUrl && (
              <a
                href={project.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between py-2 text-emerald-400 hover:text-white transition-colors group font-semibold"
              >
                <span>Démonstration En Ligne</span>
                <span class="text-emerald-400 group-hover:text-white transition-colors">↗</span>
              </a>
            )}
          </div>

          <!-- Métadonnées alignées proprement sans bordures lourdes -->
          <div class="space-y-4 font-mono text-xs text-[#888888] pb-6 border-b border-[#222222]">
            <div>
              <span class="text-[10px] uppercase text-[#555555] block mb-0.5 tracking-wider">
                COMPÉTENCE DU BUT :
              </span>
              <span class="text-[#ededed] font-semibold">
                {project.competenceTitle}
              </span>
            </div>

            <div>
              <span class="text-[10px] uppercase text-[#555555] block mb-0.5 tracking-wider">
                PÉRIODE D'EXÉCUTION :
              </span>
              <span class="text-[#ededed]">
                Année {project.year}
              </span>
            </div>

            <div>
              <span class="text-[10px] uppercase text-[#555555] block mb-0.5 tracking-wider">
                RÔLE PRINCIPAL :
              </span>
              <span class="text-[#ededed]">
                {project.personalRole.split(':')[0] || 'Conception & Développement'}
              </span>
            </div>

            <div>
              <span class="text-[10px] uppercase text-[#555555] block mb-1 tracking-wider">
                STACK TECHNIQUE :
              </span>
              <div class="flex flex-wrap gap-1.5 pt-1">
                {project.tags.map((tag) => (
                  <span class="px-2 py-0.5 border border-[#222222] bg-[#121212] text-[#ededed] text-[10px]">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Mini-Sommaire d'ancrage fluide -->
          <nav class="space-y-2 font-mono text-xs text-[#777777]" aria-label="Sommaire de l'étude de cas">
            <span class="text-[10px] uppercase text-[#555555] tracking-widest block mb-2 font-bold">
              // SOMMAIRE DE L'ÉTUDE :
            </span>
            <a
              href="#contexte"
              class="block hover:text-accent transition-colors"
            >
              [01] // CONTEXTE & OBJECTIFS
            </a>
            <a
              href="#architecture"
              class="block hover:text-accent transition-colors"
            >
              [02] // ARCHITECTURE TECHNIQUE
            </a>
            <a
              href="#competences"
              class="block hover:text-accent transition-colors"
            >
              [03] // VALIDATION COMPÉTENCES BUT
            </a>
          </nav>
        </aside>

        <!-- ========================================================
             COLONNE DROITE DÉFILANTE (70% - lg:col-span-8)
             Le Récit Éditorial & Les Preuves Visuelles Haute Définition
             ======================================================== -->
        <article class="lg:col-span-8 space-y-16 lg:space-y-20">
          <!-- Grande image principale en haut (haute définition, ratio d'origine préservé) -->
          <section class="border border-[#222222] bg-[#0c0c0c] p-3 sm:p-5">
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-[#222222] font-mono text-[11px] text-[#888888]">
              <span class="text-[#ededed] font-semibold uppercase tracking-wider">
                DOCUMENTATION VISUELLE // {project.title}
              </span>
              {project.images.length > 0 && (
                <button
                  type="button"
                  id="trigger-lightbox-btn"
                  class="text-accent hover:text-white transition-colors flex items-center gap-1 cursor-pointer font-bold"
                  title="Agrandir en plein écran"
                >
                  <span>AGRANDIR HAUTE DÉFINITION</span>
                  <span>⤢</span>
                </button>
              )}
            </div>

            {project.images.length > 0 ? (
              <div class="space-y-3">
                <div class="h-[340px] sm:h-[420px] md:h-[480px] w-full bg-[#060606] border border-[#1f1f1f] flex items-center justify-center p-2 relative overflow-hidden group select-none">
                  <img
                    id="hero-project-image"
                    src={project.images[0]}
                    alt={`Trace visuelle principale pour ${project.title}`}
                    class="max-w-full max-h-full w-auto h-auto object-contain cursor-zoom-in transition-transform duration-200 group-hover:scale-[1.01]"
                    title="Cliquer pour examiner en haute définition"
                  />
                  <div class="absolute bottom-3 right-3 px-2 py-1 bg-black/90 font-mono text-[10px] text-accent border border-[#262626] opacity-0 group-hover:opacity-100 transition-opacity">
                    CLIQUER POUR AGRANDIR ⤢
                  </div>
                </div>

                <!-- Galerie de vignettes si plusieurs captures -->
                {project.images.length > 1 && (
                  <div class="flex gap-2 overflow-x-auto pb-1 pt-1" role="tablist">
                    {project.images.map((img, idx) => (
                      <button
                        type="button"
                        class={`thumbnail-btn h-14 sm:h-18 aspect-video border overflow-hidden shrink-0 cursor-pointer transition-all p-1 bg-[#090909] ${
                          idx === 0 ? 'border-accent' : 'border-[#222222] hover:border-[#444444]'
                        }`}
                        data-image-src={img}
                        aria-label={`Afficher la capture ${idx + 1}`}
                      >
                        <img
                          src={img}
                          alt=""
                          class="w-full h-full object-contain"
                          loading="lazy"
                        />
                      </button>
                    ))}
                  </div>
                )}
              </div>
            ) : (
              <!-- Projet Système / CTF sans interface graphique : Télémétrie / Architecture dédiée -->
              <div class="h-64 sm:h-80 w-full border border-dashed border-[#262626] bg-[#080808] p-6 flex flex-col justify-between font-mono text-xs">
                <div class="flex items-center justify-between border-b border-[#222222] pb-2">
                  <span class="text-[#ededed] font-bold">ARCHITECTURE SYSTÈME & CODE DSI</span>
                  <span class="text-emerald-400">● VALIDÉ</span>
                </div>
                <div class="space-y-1.5 my-auto text-xs text-[#888888]">
                  <div class="text-[#555555]">// COMPOSANTS DÉPLOYÉS EN PRODUCTION</div>
                  <div class="text-[#ededed] font-semibold">ORCHESTRATION DOCKER & KATHARA EMULATION</div>
                  <div class="text-accent">ISOLATION DES SOUS-RÉSEAUX & SÉCURISATION CTF</div>
                  <div class="text-[#777777]">Code source et recettes d'infrastructure disponibles sur demande.</div>
                </div>
                <div class="pt-2 border-t border-[#222222] flex justify-between text-[11px] text-[#555555]">
                  <span>ENV: LINUX DEBIAN</span>
                  <span class="text-[#ededed]">UNIVERSITÉ DE LIMOGES</span>
                </div>
              </div>
            )}
          </section>

          <!-- Section 01 : Contexte & Objectifs -->
          <section id="contexte" class="pt-4 border-t border-[#222222]">
            <div class="flex items-center gap-2 font-mono text-xs text-accent uppercase tracking-wider mb-3">
              <span>01 //</span>
              <span>CONTEXTE & PROBLÉMATIQUE TECHNIQUE</span>
            </div>

            <h2 class="font-serif text-3xl sm:text-4xl text-[#ededed] mb-6 leading-tight">
              Enjeux du Projet & Cadrage
            </h2>

            <div class="font-mono text-xs sm:text-sm text-[#999999] leading-relaxed max-w-3xl space-y-4">
              <p>{project.descriptionDetailed}</p>
            </div>

            <!-- Encart défi technique spécifique -->
            <div class="mt-8 p-5 border-l-2 border-accent bg-[#0d0d0d] font-mono text-xs leading-relaxed max-w-3xl">
              <strong class="text-[#ededed] uppercase text-[11px] tracking-wider block mb-1">
                Défi technique spécifique rencontré :
              </strong>
              <p class="text-[#888888]">{project.technicalProblem}</p>
            </div>
          </section>

          <!-- Section 02 : Architecture Technique & Rôle Personnel -->
          <section id="architecture" class="pt-4 border-t border-[#222222]">
            <div class="flex items-center gap-2 font-mono text-xs text-accent uppercase tracking-wider mb-3">
              <span>02 //</span>
              <span>ARCHITECTURE TECHNIQUE & CONTRIBUTION</span>
            </div>

            <h2 class="font-serif text-3xl sm:text-4xl text-[#ededed] mb-6 leading-tight">
              Conception, Rôle & Résultats Tangibles
            </h2>

            <div class="space-y-8 max-w-3xl font-mono text-xs sm:text-sm text-[#999999] leading-relaxed">
              <!-- Rôle individuel -->
              <div>
                <h3 class="text-xs uppercase tracking-wider text-[#ededed] font-bold mb-3 font-mono">
                  // RÔLE PERSONNEL & RESPONSABILITÉS :
                </h3>
                <p>{project.personalRole}</p>
              </div>

              <!-- Livrables -->
              <div class="p-5 border border-[#222222] bg-[#0c0c0c]">
                <h3 class="text-xs uppercase tracking-wider text-accent font-bold mb-2 font-mono">
                  // LIVRABLES & PRODUCTIONS DU PROJET :
                </h3>
                <p class="text-[#888888] text-xs leading-relaxed">{project.deliverables}</p>
              </div>
            </div>
          </section>

          <!-- Section 03 : Validation des Compétences du BUT (Format Noble et Ouvert) -->
          <section id="competences" class="pt-4 border-t border-[#222222]">
            <div class="flex items-center gap-2 font-mono text-xs text-accent uppercase tracking-wider mb-3">
              <span>03 //</span>
              <span>VALIDATION DES COMPÉTENCES DU BUT INFORMATIQUE</span>
            </div>

            <h2 class="font-serif text-3xl sm:text-4xl text-[#ededed] mb-6 leading-tight">
              Apprentissages Critiques & Justification Réflexive
            </h2>

            <!-- En-tête de la compétence -->
            <div class="mb-8 p-4 border border-[#262626] bg-[#0c0c0c] flex items-center justify-between flex-wrap gap-3 font-mono text-xs">
              <div class="flex items-center gap-2.5">
                <span class="w-2 h-2 bg-emerald-500"></span>
                <span class="text-[#ededed] font-bold uppercase tracking-wider">
                  COMPÉTENCE ÉVALUÉE :
                </span>
                <span class="text-accent font-semibold">{project.competenceTitle}</span>
              </div>
              <span class="text-[10px] text-emerald-400 bg-emerald-950/60 border border-emerald-800 px-2 py-0.5 uppercase">
                ACQUISITION CONFIRMÉE
              </span>
            </div>

            <!-- Liste des Apprentissages Critiques (AC) -->
            <div class="space-y-3 mb-10 max-w-3xl font-mono text-xs">
              {project.criticalLearnings.map((learning) => (
                <div class="p-4 border-l-2 border-emerald-500 bg-[#0d0d0d] flex items-start gap-3">
                  <span class="text-emerald-400 font-bold">●</span>
                  <span class="text-[#ededed] leading-relaxed">{learning}</span>
                </div>
              ))}
            </div>

            <!-- Justification Réflexive & Preuve Visuelle associée -->
            <div class="p-6 border border-[#222222] bg-[#0b0b0b] max-w-3xl space-y-4 font-mono text-xs leading-relaxed">
              <h3 class="text-xs uppercase tracking-wider text-accent font-bold">
                // BILAN RÉFLEXIF & DÉMONSTRATION DU CANDIDAT :
              </h3>
              <p class="text-[#999999]">
                Ce projet a constitué une mise en situation authentique me permettant de mobiliser des concepts théoriques de génie logiciel, d'algorithmique et d'administration sous Linux. L'exigence de modularité et la traçabilité du code garantissent la pérennité de la solution livrée.
              </p>

              {project.images.length > 0 && (
                <div class="pt-4 border-t border-[#1f1f1f] flex items-center justify-between">
                  <span class="text-[#666666]">PREUVE LIÉE AU RÉFÉRENTIEL :</span>
                  <button
                    type="button"
                    class="secondary-lightbox-trigger text-accent hover:text-white transition-colors cursor-pointer font-bold flex items-center gap-1"
                  >
                    <span>EXAMINER LA PREUVE EN PLEIN ÉCRAN</span>
                    <span>↗</span>
                  </button>
                </div>
              )}
            </div>
          </section>

          <!-- Navigation de transition fluide vers le projet suivant -->
          <footer class="pt-16 border-t border-[#222222] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
            {nextProject ? (
              <a
                href={`/projets/${nextProject.slug}`}
                class="group flex flex-col items-start gap-1 select-none"
              >
                <span class="font-mono text-xs uppercase text-[#777777] tracking-wider">
                  PROJET SUIVANT →
                </span>
                <span class="font-serif text-2xl sm:text-3xl text-[#ededed] group-hover:text-accent group-hover:translate-x-1.5 transition-all leading-snug">
                  {nextProject.title}
                </span>
              </a>
            ) : prevProject ? (
              <a
                href={`/projets/${prevProject.slug}`}
                class="group flex flex-col items-start gap-1 select-none"
              >
                <span class="font-mono text-xs uppercase text-[#777777] tracking-wider">
                  ← PREMIER PROJET DU CATALOGUE
                </span>
                <span class="font-serif text-2xl sm:text-3xl text-[#ededed] group-hover:text-accent group-hover:translate-x-1.5 transition-all leading-snug">
                  {prevProject.title}
                </span>
              </a>
            ) : null}

            <a
              href="/projets"
              class="font-mono text-xs uppercase tracking-wider text-[#888888] hover:text-white border-b border-[#333333] hover:border-white transition-colors pb-1 shrink-0"
            >
              Consulter l'Index des Projets ↗
            </a>
          </footer>
        </article>
      </div>
    </main>

    <!-- ========================================================
         MODALE / LIGHTBOX HAUTE DÉFINITION PLEIN ÉCRAN
         Permet au jury d'examiner chaque capture, schéma ou code sans réduction
         ======================================================== -->
    <dialog
      id="lightbox-dialog"
      class="backdrop:bg-black/95 bg-transparent p-4 sm:p-8 max-w-7xl max-h-[96vh] w-full m-auto border-0 focus:outline-none"
    >
      <div class="relative bg-[#0c0c0c] border border-[#262626] p-4 sm:p-6 flex flex-col max-h-[92vh] select-none">
        <div class="flex items-center justify-between pb-3 mb-3 border-b border-[#262626] font-mono text-xs text-[#888888]">
          <div class="flex items-center gap-2 truncate pr-4">
            <span class="text-accent font-bold">[VUE HAUTE DÉFINITION]</span>
            <span class="text-[#ededed] truncate">{project.title}</span>
          </div>
          <button
            id="close-lightbox-btn"
            type="button"
            class="px-3.5 py-1.5 bg-[#141414] hover:bg-white hover:text-black text-white font-mono text-xs border border-[#333333] transition-colors cursor-pointer font-bold"
          >
            FERMER [ESC] ✕
          </button>
        </div>

        <div class="grow overflow-auto flex items-center justify-center p-2 bg-[#050505]">
          <img
            id="lightbox-image"
            src={project.images.length > 0 ? project.images[0] : ''}
            alt=""
            class="max-h-[78vh] max-w-full w-auto h-auto object-contain mx-auto"
          />
        </div>
      </div>
    </dialog>
  </div>
</Layout>

<script>
  // ========================================================
  // INTERACTIVE GALLERY & HIGH-DEFINITION LIGHTBOX
  // ========================================================
  function initProjectDetail() {
    const heroImg = document.getElementById('hero-project-image') as HTMLImageElement | null;
    const thumbnailBtns = document.querySelectorAll<HTMLButtonElement>('.thumbnail-btn');
    const lightboxDialog = document.getElementById('lightbox-dialog') as HTMLDialogElement | null;
    const lightboxImg = document.getElementById('lightbox-image') as HTMLImageElement | null;
    const triggerLightboxBtn = document.getElementById('trigger-lightbox-btn');
    const secondaryTrigger = document.querySelector<HTMLButtonElement>('.secondary-lightbox-trigger');
    const closeLightboxBtn = document.getElementById('close-lightbox-btn');

    // Changement de l'image via les vignettes
    thumbnailBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-image-src');
        if (src && heroImg) {
          heroImg.src = src;
          thumbnailBtns.forEach((b) => {
            b.classList.remove('border-accent');
            b.classList.add('border-[#222222]');
          });
          btn.classList.add('border-accent');
          btn.classList.remove('border-[#222222]');
        }
      });
    });

    // Fonctions de la visionneuse plein écran
    function openLightbox() {
      if (lightboxDialog && lightboxImg && heroImg) {
        lightboxImg.src = heroImg.src;
        lightboxDialog.showModal();
      }
    }

    function closeLightbox() {
      if (lightboxDialog) {
        lightboxDialog.close();
      }
    }

    heroImg?.addEventListener('click', openLightbox);
    triggerLightboxBtn?.addEventListener('click', openLightbox);
    secondaryTrigger?.addEventListener('click', openLightbox);
    closeLightboxBtn?.addEventListener('click', closeLightbox);

    lightboxDialog?.addEventListener('click', (e) => {
      if (e.target === lightboxDialog) {
        closeLightbox();
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightboxDialog?.open) {
        closeLightbox();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initProjectDetail);
  initProjectDetail();
</script>
