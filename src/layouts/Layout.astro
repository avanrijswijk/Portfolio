---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Adrian van Rijswijk // Portfolio BUT Informatique',
  description = 'Portfolio technique d’Adrian van Rijswijk, étudiant en 3ème année de BUT Informatique (RACDV). Conception logicielle, architectures web et systèmes distribués.',
} = Astro.props;
---

<!doctype html>
<html lang="fr" class="bg-[#0a0a0a] text-[#ededed]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Adrian van Rijswijk" />
    <meta name="theme-color" content="#0a0a0a" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://avanrijswijk.github.io" />

    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-[#0a0a0a] text-[#ededed] antialiased selection:bg-[#ededed] selection:text-[#0a0a0a]">
    <!-- Technical Datasheet Main Container: centered, max-w-7xl, compartmentalized borders -->
    <div class="mx-auto max-w-7xl border-x border-neutral-800 bg-[#0a0a0a] shadow-none">
      <slot />
    </div>
  </body>
</html>
