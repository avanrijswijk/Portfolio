---
import { PROFILE } from '../data/profile';
---

<section class="border-b border-neutral-800 bg-[#0a0a0a]">
  <div class="grid grid-cols-1 lg:grid-cols-[60%_40%]">
    <!-- Colonne gauche (60% sur desktop) avec espacements aérés -->
    <div class="p-8 sm:p-12 lg:p-16 border-b lg:border-b-0 lg:border-r border-neutral-800 flex flex-col justify-between">
      <div>
        <!-- En-tête technique -->
        <div class="flex items-center gap-3 font-mono text-xs text-neutral-500 uppercase tracking-widest mb-8">
          <span class="text-neutral-300 font-semibold">[00]</span>
          <span>PRÉSENTATION</span>
          <span class="text-neutral-700">//</span>
          <span class="text-neutral-400">BUT INFORMATIQUE</span>
        </div>

        <!-- Prénom Nom -->
        <h1 class="text-3xl sm:text-4xl lg:text-[2.85rem] font-bold text-neutral-100 font-mono tracking-tight leading-[1.2] uppercase mb-8">
          {PROFILE.fullName}
        </h1>

        <!-- Court paragraphe de présentation aéré -->
        <p class="text-neutral-400 text-base sm:text-lg leading-relaxed max-w-2xl font-sans mb-10">
          {PROFILE.heroBio}
        </p>

        <!-- Deux boutons d'action généreux -->
        <div class="flex flex-col sm:flex-row gap-4 pt-2">
          <a
            href="/projets"
            class="px-7 py-4 bg-neutral-100 text-neutral-950 hover:bg-white font-mono text-xs font-bold uppercase tracking-wider transition-colors inline-flex items-center justify-center gap-2.5 group"
          >
            <span>Explorer tous les projets</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>

          <a
            href={PROFILE.contacts.cvUrl}
            class="px-7 py-4 border border-neutral-700 hover:border-neutral-400 hover:bg-neutral-900 text-neutral-200 font-mono text-xs font-semibold uppercase tracking-wider transition-colors inline-flex items-center justify-center gap-2.5 group"
          >
            <span>Télécharger CV</span>
            <span class="group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">↗</span>
          </a>
        </div>
      </div>

      <!-- Bandeau technique bas de cellule avec respiration -->
      <div class="mt-14 pt-8 border-t border-neutral-800 grid grid-cols-2 sm:grid-cols-3 gap-6 font-mono text-xs text-neutral-500">
        <div>
          <span class="block text-neutral-600 uppercase text-[10px] mb-1">Localisation</span>
          <span class="text-neutral-300 font-medium">Limoges, France</span>
        </div>
        <div>
          <span class="block text-neutral-600 uppercase text-[10px] mb-1">Formation</span>
          <span class="text-neutral-300 font-medium">BUT 3 (IUT Limousin)</span>
        </div>
        <div class="col-span-2 sm:col-span-1">
          <span class="block text-neutral-600 uppercase text-[10px] mb-1">Parcours</span>
          <span class="text-neutral-300 font-medium">RACDV & DevOps</span>
        </div>
      </div>
    </div>

    <!-- Colonne droite (40% sur desktop) : Placeholder Visuel 1-Bit aéré -->
    <div class="p-8 sm:p-12 lg:p-16 flex flex-col justify-center items-center bg-[#0d0d0d]">
      <div class="w-full h-full min-h-[360px] lg:min-h-[480px] border border-dashed border-neutral-700/80 bg-neutral-900/40 p-8 flex flex-col justify-between items-center relative overflow-hidden">
        <!-- Répères techniques d'angles -->
        <span class="absolute top-3 left-3 font-mono text-[11px] text-neutral-600 select-none">+ 00.00</span>
        <span class="absolute top-3 right-3 font-mono text-[11px] text-neutral-600 select-none">CANVAS_1BIT +</span>
        <span class="absolute bottom-3 left-3 font-mono text-[11px] text-neutral-600 select-none">+ DITHER_VIEWPORT</span>
        <span class="absolute bottom-3 right-3 font-mono text-[11px] text-neutral-600 select-none">64x64px +</span>

        <div class="m-auto text-center p-6">
          <div class="w-16 h-16 border border-neutral-700 mx-auto mb-5 flex items-center justify-center font-mono text-neutral-400 text-sm font-bold bg-neutral-950">
            1-BIT
          </div>
          <p class="font-mono text-sm uppercase tracking-widest text-neutral-300 font-bold mb-3">
            [PLACEHOLDER : VISUEL 1-BIT INTERACTIF]
          </p>
          <p class="font-mono text-xs text-neutral-500 max-w-xs mx-auto leading-relaxed">
            Emplacement réservé pour l’animation interactive en tramage (dithering) noir et blanc (phase 2).
          </p>
        </div>

        <div class="w-full pt-4 border-t border-neutral-800/80 flex justify-between font-mono text-[11px] text-neutral-600">
          <span>STATUS: STANDBY</span>
          <span>STEP_01 // LAYOUT</span>
        </div>
      </div>
    </div>
  </div>
</section>
