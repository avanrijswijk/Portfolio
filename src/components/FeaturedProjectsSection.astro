---
import { getFeaturedProjects } from '../data/projects';

const featuredProjects = getFeaturedProjects();
---

<section id="projets" class="border-b border-neutral-800 bg-[#0a0a0a]">
  <!-- En-tête de la section Projets Phares avec espacement généreux -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between px-8 sm:px-12 py-6 border-b border-neutral-800 bg-neutral-950 gap-4">
    <div class="flex items-center gap-3 font-mono text-xs sm:text-sm font-bold uppercase tracking-wider text-neutral-100">
      <span class="text-neutral-500">01 //</span>
      <h2>PROJETS PHARES SÉLECTIONNÉS</h2>
    </div>

    <div class="flex items-center gap-3 font-mono text-xs text-neutral-400">
      <span class="px-2.5 py-1 border border-neutral-800 bg-neutral-900/60 text-emerald-400 font-medium">
        {featuredProjects.length} PROJETS MAJEURS
      </span>
      <a href="/projets" class="text-neutral-400 hover:text-white transition-colors hidden sm:inline-flex items-center gap-1">
        <span>Tous les projets</span>
        <span>→</span>
      </a>
    </div>
  </div>

  <!-- Grille des 3 projets phares (1 col mobile, 3 cols desktop, bordures 1px nettes sans doublons) -->
  <div class="grid grid-cols-1 lg:grid-cols-3 bg-neutral-800 gap-[1px]">
    {featuredProjects.map((project) => (
      <article class="flex flex-col justify-between bg-[#0a0a0a] hover:bg-[#0e0e0e] transition-colors p-0 group">
        <!-- En-tête de carte -->
        <div class="px-6 py-4 border-b border-neutral-800 flex items-center justify-between font-mono text-xs text-neutral-400 bg-neutral-950/60">
          <div class="flex items-center gap-2">
            <span class="text-neutral-100 font-bold">{project.index}</span>
            <span class="text-neutral-600">//</span>
            <span class="text-neutral-400">{project.year}</span>
          </div>
          <span class="px-2 py-0.5 border border-neutral-800 text-[10px] font-mono text-neutral-300 uppercase bg-neutral-900/40">
            {project.competenceId.toUpperCase()}
          </span>
        </div>

        <!-- Zone d'aperçu 16/9 -->
        <a
          href={`/projets/${project.slug}`}
          class="aspect-video w-full bg-neutral-950 border-b border-neutral-800 relative flex items-center justify-center overflow-hidden block"
        >
          {project.image ? (
            <img
              src={project.image}
              alt={`Aperçu du projet ${project.title}`}
              class="w-full h-full object-cover object-top grayscale group-hover:grayscale-0 opacity-80 group-hover:opacity-100 transition-all duration-300"
              loading="lazy"
            />
          ) : (
            <div class="w-full h-full flex flex-col items-center justify-center p-6 border border-dashed border-neutral-800/80 m-3 bg-neutral-900/30">
              <span class="font-mono text-xs uppercase tracking-wider text-neutral-400 font-semibold">
                [APERÇU ARCHITECTURE]
              </span>
              <span class="font-mono text-[10px] text-neutral-600 mt-1">
                INFRASTRUCTURE & CODE
              </span>
            </div>
          )}
          <div class="absolute bottom-3 right-3 px-2 py-1 bg-neutral-950/90 font-mono text-[10px] text-neutral-300 border border-neutral-800 opacity-0 group-hover:opacity-100 transition-opacity">
            OUVRIR LA FICHE →
          </div>
        </a>

        <!-- Corps de la carte -->
        <div class="p-6 sm:p-7 grow flex flex-col">
          <span class="font-mono text-[11px] text-neutral-500 uppercase tracking-wider mb-2 block">
            {project.competenceTitle}
          </span>

          <h3 class="font-mono font-bold text-lg text-neutral-100 mb-3 group-hover:text-emerald-400 transition-colors leading-snug">
            <a href={`/projets/${project.slug}`}>
              {project.title}
            </a>
          </h3>

          <p class="text-sm text-neutral-300 font-sans leading-relaxed mb-5">
            {project.shortDescription}
          </p>

          <!-- Problématique technique -->
          <div class="mt-auto pt-4 border-t border-neutral-800/80">
            <p class="text-xs font-mono text-neutral-400 leading-relaxed">
              <strong class="text-neutral-200 font-semibold uppercase text-[10px] block mb-1 tracking-wider">
                Problématique technique :
              </strong>
              {project.technicalProblem}
            </p>
          </div>
        </div>

        <!-- Pied de carte : Tags + Liens -->
        <div class="p-6 border-t border-neutral-800 bg-neutral-950/40 flex flex-col gap-4">
          <!-- Tags techniques encadrés -->
          <div class="flex flex-wrap gap-1.5" aria-label="Technologies utilisées">
            {project.tags.slice(0, 4).map((tag) => (
              <span class="px-2.5 py-1 border border-neutral-800 font-mono text-[10px] text-neutral-400 uppercase tracking-tight bg-neutral-900/60">
                {tag}
              </span>
            ))}
            {project.tags.length > 4 && (
              <span class="px-2 py-1 border border-neutral-800 font-mono text-[10px] text-neutral-500">
                +{project.tags.length - 4}
              </span>
            )}
          </div>

          <!-- Actions -->
          <div class="flex items-center justify-between pt-3 border-t border-neutral-800/80 font-mono text-xs">
            <a
              href={`/projets/${project.slug}`}
              class="text-neutral-100 hover:text-emerald-400 font-semibold transition-colors inline-flex items-center gap-1.5"
            >
              <span>Fiche détaillée</span>
              <span>→</span>
            </a>

            {project.githubUrl && (
              <a
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-neutral-400 hover:text-white transition-colors inline-flex items-center gap-1 group/gh"
              >
                <span>GitHub</span>
                <span class="group-hover/gh:translate-x-0.5 group-hover/gh:-translate-y-0.5 transition-transform">↗</span>
              </a>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>

  <!-- Gros bouton en bas de la grille renvoyant vers /projets -->
  <div class="p-8 sm:p-12 border-t border-neutral-800 bg-neutral-950/90 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
    <div class="max-w-2xl">
      <span class="font-mono text-xs uppercase tracking-wider text-emerald-400 font-semibold block mb-2">
        [RÉFÉRENTIEL NATIONAL BUT INFORMATIQUE]
      </span>
      <h3 class="font-mono text-lg sm:text-xl font-bold text-neutral-100 uppercase tracking-tight">
        Consulter l’ensemble des projets classés par compétences (C1 à C6)
      </h3>
      <p class="text-sm text-neutral-400 font-sans mt-2 leading-relaxed">
        Découvrez l’intégralité des réalisations académiques et professionnelles structurées selon les 6 compétences du BUT : Réaliser, Optimiser, Administrer, Gérer, Conduire et Collaborer.
      </p>
    </div>

    <a
      href="/projets"
      class="w-full lg:w-auto px-8 py-5 bg-neutral-100 text-neutral-950 hover:bg-white font-mono text-xs font-bold uppercase tracking-wider transition-all inline-flex items-center justify-center gap-3 shrink-0 group"
    >
      <span>Voir tous les projets par compétences</span>
      <span class="group-hover:translate-x-1.5 transition-transform text-sm">→</span>
    </a>
  </div>
</section>
